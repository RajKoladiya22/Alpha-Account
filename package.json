{
  "name": "xero-core-engine",
  "version": "1.0.0",
  "description": "Production-grade, multi-tenant cloud financial accounting and document lifecycle engine",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:custom": "node --experimental-strip-types server.js",
    "connect": "bash connect",
    "connect-db": "bash connect db",
    "connect:db": "bash connect db",
    "db:connect": "bash connect db",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "test": "node --test tests/*.test.ts",
    "test:watch": "node --test --watch tests/*.test.ts"
  },
  "keywords": [
    "accounting",
    "double-entry",
    "fintech",
    "reconciliation",
    "multi-tenant",
    "webauthn",
    "nextjs",
    "prisma"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/jsonwebtoken": "^9.0.10",
    "autoprefixer": "^10.6.1",
    "jsonwebtoken": "^9.0.3",
    "next": "^14.2.15",
    "postcss": "^8.5.31",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.14",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
