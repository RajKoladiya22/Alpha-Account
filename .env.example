# ==============================================================================
# Alpha Steel Frames - Production Environment Configuration (.env)
# Hostinger Node.js Shared Hosting Deployment
# ==============================================================================

# Node Environment
NODE_ENV="production"

# Port (Hostinger automatically provides the PORT environment variable; fallback: 3000)
PORT=3000

# Canonical Application URL
NEXT_PUBLIC_APP_URL="https://go.alphasteelframes.com.au"
APP_URL="https://go.alphasteelframes.com.au"

# MySQL Database Connection URL (Configured from Hostinger hPanel -> Databases -> MySQL Databases)
# Format: mysql://<db_user>:<db_password>@<db_host>:3306/<db_name>
# Note: On Hostinger shared hosting, <db_host> is typically 'localhost' or '127.0.0.1'
DATABASE_URL="mysql://u123456789_asf_user:StrongPasswordHere123!@localhost:3306/u123456789_asf_db"

# JWT Cryptographic Signing Secret Key (Minimum 64 characters recommended for production)
# Generate with: openssl rand -hex 32
JWT_SECRET="generate-a-strong-random-64-character-hex-secret-for-production-signing"

# Organization Subdomain & Routing
NEXT_PUBLIC_SHELL_DOMAIN="go.alphasteelframes.com.au"
NEXT_PUBLIC_MARKETING_DOMAIN="alphasteelframes.com.au"
NEXT_PUBLIC_AUTH_DOMAIN="go.alphasteelframes.com.au"
