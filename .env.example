# Database connection URL (PostgreSQL / MySQL)
DATABASE_URL="postgresql://user:password@localhost:5432/xero_db?schema=public"

# JWT Secret Key for Session Authentication (minimum 32 characters)
JWT_SECRET="your_fintech_super_secure_jwt_signing_key_32bytes_min!"

# Application URLs and Subdomain Routing
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETING_DOMAIN="www.yourdomain.com"
NEXT_PUBLIC_SHELL_DOMAIN="go.yourdomain.com"
NEXT_PUBLIC_AUTH_DOMAIN="login.yourdomain.com"

# Server Port
PORT=3000
